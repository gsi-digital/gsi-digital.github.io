{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all" } },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "assist": { "actions": { "source": { "organizeImports": { "level": "on" } } } },
  "files": {
    "includes": ["**/*.js", "**/*.ts", "**/*.mjs", "**/*.json", "!.astro", "!dist", "!node_modules"]
  }
}
