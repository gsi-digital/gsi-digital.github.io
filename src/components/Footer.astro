---
import { projects } from '../data/projects';
import { type Lang, routes, t } from '../i18n/ui';
import Arrow from './Arrow.astro';
import Mark from './Mark.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const linked = projects.filter((p) => p.url);
const year = new Date().getFullYear();
---
<footer class="footer">
  <Mark class="watermark" />
  <div class="wrap inner">
    <div class="row">
      <div class="brand">
        <img src="/brand/quer-limette.svg" alt="GSI Digital" width="446" height="132" loading="lazy" />
        <p>{t(lang, 'footer.tagline')}</p>
      </div>
      {
        linked.length > 0 && (
          <nav aria-label={t(lang, 'footer.projects')}>
            <ul>
              {linked.map((p) => (
                <li>
                  <a href={p.url} rel="noopener">
                    <Arrow class="arrow" />
                    {p.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
    <div class="legal">
      <p>© {year} GSI Digital</p>
      <ul>
        <li><a href={routes.imprint[lang]}>{t(lang, 'footer.imprint')}</a></li>
        <li><a href={routes.privacy[lang]}>{t(lang, 'footer.privacy')}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding-block: 3rem 2rem;
    background: var(--color-anthra);
    color: #e9eadf;
  }
  .footer :global(.watermark) {
    position: absolute;
    top: -1.5rem;
    right: -2rem;
    width: 16rem;
    color: var(--color-lime);
    opacity: 0.08;
  }
  .inner {
    position: relative;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }
  .brand img {
    display: block;
    height: 3.4rem;
    width: auto;
    margin-left: -0.35rem;
  }
  .brand p {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: #b9bab1;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav ul {
    display: grid;
    gap: 0.25rem;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0;
  }
  nav a:hover {
    color: var(--color-lime);
  }
  nav :global(.arrow) {
    width: 1.1rem;
    height: 0.6rem;
    color: var(--color-lime);
    transition: transform 0.25s ease;
  }
  nav a:hover :global(.arrow) {
    transform: translateX(3px);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.8rem;
    color: #a9aaa2;
  }
  .legal p {
    margin: 0;
  }
  .legal ul {
    display: flex;
    gap: 1.25rem;
  }
  .legal a:hover {
    color: var(--color-lime);
  }
  .footer :focus-visible {
    outline-color: var(--color-lime);
  }
</style>
