---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<article class="wrap prose">
  <h1>{title}</h1>
  <slot />
</article>

<style>
  .prose {
    max-width: 46rem;
    padding-block: 1.5rem 4rem;
  }
  .prose :global(h1) {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-petrol);
  }
  .prose :global(h2) {
    margin: 2rem 0 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-petrol);
  }
  .prose :global(p),
  .prose :global(address) {
    margin: 0 0 1rem;
    font-style: normal;
  }
  .prose :global(a) {
    color: var(--color-petrol);
    text-underline-offset: 3px;
  }
  .prose :global(mark) {
    padding: 0 0.25rem;
    border-radius: 4px;
    background: var(--color-lime);
  }
</style>
